import {
  "gmlewis/base64",
  "gmlewis/spin-moonbit-sdk/gen",
  "gmlewis/spin-moonbit-sdk/interface/fermyon/spin/variables" as @spinvariables,
  "gmlewis/spin-moonbit-sdk/interface/wasi/http/types",
  "gmlewis/spin-moonbit-sdk/util",
}

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "exports": [
        "cabi_realloc:cabi_realloc",
        "wasmExportHandle:wasi:http/incoming-handler@0.2.0#handle",
      ],
      "heap-start-address": 16,
    },
  },
)